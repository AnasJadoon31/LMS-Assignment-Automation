# Settings for docker compose. Run scripts/init-env.sh to create .env with fresh
# secrets, then fill in the blanks. On Coolify, enter the same names as the
# resource's environment variables instead.

# --- Your CMS login (the form asks for all four) ---
CMS_ENROLLMENT=
CMS_PASSWORD=
CMS_INSTITUTE=Karachi Campus
CMS_ROLE=Student

# --- Secrets: letters and digits only (they go inside connection URLs) ---
POSTGRES_PASSWORD=
# Encrypts the stored LMS session. Changing it later only forces a fresh CMS login.
APP_SECRET_KEY=
# Shared by the worker and the bundled Evolution API
EVOLUTION_API_KEY=

# --- The setup page (/setup on the api): sign Claude in, link WhatsApp ---
# Its password. init-env.sh makes one; keep it somewhere safe.
ADMIN_PASSWORD=
# Where the page is reachable, e.g. https://lms.example.com; alerts link to it
PUBLIC_URL=

# --- Notifications: WhatsApp, Discord, or both ---
# Your own number, which receives the messages; country code first, no + or leading 0
WHATSAPP_NUMBER=
# Optional: a Discord channel webhook URL
DISCORD_WEBHOOK_URL=

# --- Only if you run Evolution API somewhere else ---
# EVOLUTION_API_URL=https://evolution.example.com
# EVOLUTION_INSTANCE=lms

# --- Solving (Claude Pro limits) ---
# Pause solving when a usage window passes this share of the limit, keeping the rest for your chats
# SOLVER_PAUSE_AT=0.8
# At most this many solver runs per day (Pakistan time)
# SOLVER_DAILY_CAP=6
# A model for the solver, e.g. claude-sonnet-5-5; empty uses your plan's default
# SOLVER_MODEL=
