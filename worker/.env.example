# Copy to worker/.env (git-ignored). In production these come from the
# web UI's Settings page, stored encrypted in PostgreSQL.

# CMS login: the form asks for all four
CMS_ENROLLMENT=
CMS_PASSWORD=
CMS_INSTITUTE=Karachi Campus
CMS_ROLE=Student

# Where the saved session, failure counter and spike recordings live
STATE_DIR=./state

# Portal URLs (override only for testing)
# CMS_LOGIN_URL=https://cms.bahria.edu.pk/Logins/Student/Login.aspx
# LMS_DASHBOARD_URL=https://lms.bahria.edu.pk/Student/Dashboard.php
