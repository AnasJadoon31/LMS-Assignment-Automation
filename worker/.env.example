# Copy to worker/.env (git-ignored) for local runs. On Coolify, set these as
# environment variables / secrets on the worker service instead.

# CMS login: the form asks for all four
CMS_ENROLLMENT=
CMS_PASSWORD=
CMS_INSTITUTE=Karachi Campus
CMS_ROLE=Student

# PostgreSQL. Without DATABASE_URL, the spike commands keep state in STATE_DIR files.
# DATABASE_URL=postgresql://lms:password@localhost:5432/lms
# Encrypts the stored LMS session; any random string of 32+ characters. Changing it
# makes the stored session unreadable (the worker then logs in again).
APP_SECRET_KEY=

# Where question files and later outputs are kept: /data/{course}/{assignment}/{revision}/
DATA_DIR=./data
STATE_DIR=./state

# Notifications: set either or both. With neither, messages go to the log.
# WhatsApp through Evolution API (two-way; approvals will happen here)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_NUMBER=
# Discord webhook (one-way: alerts and files only)
DISCORD_WEBHOOK_URL=

# Portal URLs (override only for testing)
# CMS_LOGIN_URL=https://cms.bahria.edu.pk/Logins/Student/Login.aspx
# LMS_DASHBOARD_URL=https://lms.bahria.edu.pk/Student/Dashboard.php
